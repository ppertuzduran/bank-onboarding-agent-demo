# Entorno de ejecución: local | dev | staging | production
ENVIRONMENT=local
SERVICE_NAME=onboarding-orchestrator
SERVICE_VERSION=0.2.0

# Secretos — en entornos reales vienen de un gestor de secretos
# Fernet (urlsafe-base64, 32 bytes). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# API Key del endpoint (header X-API-Key). Vacía deshabilita auth solo en LOCAL.
API_KEY=

# Directorios locales
DATA_DIR=./data
DOCS_PLAIN_DIR=./data/synthetic_docs
DOCS_ENCRYPTED_DIR=./data/encrypted
CHROMA_DIR=./data/chroma
STATE_DB_PATH=./data/state.sqlite

# Umbrales de orquestación
IDENTITY_CONFIDENCE_THRESHOLD=0.8
RETRIEVAL_TOP_K=3

# Configuración RAG local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_COLLECTION=bank_policies

# CORS (coma-separado); vacío usa el default seguro de config.py
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Rate limiting (token bucket)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30

# AWS (Fase 2 — dejar vacío en local)
AWS_REGION=
AWS_PROFILE=
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
