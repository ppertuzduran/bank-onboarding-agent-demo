# Clave Fernet para cifrar documentos locales. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Directorios locales
DATA_DIR=./data
DOCS_PLAIN_DIR=./data/synthetic_docs
DOCS_ENCRYPTED_DIR=./data/encrypted
CHROMA_DIR=./data/chroma
STATE_DB_PATH=./data/state.sqlite

# Umbrales de orquestación
IDENTITY_CONFIDENCE_THRESHOLD=0.8
RETRIEVAL_TOP_K=3

# Configuración RAG local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_COLLECTION=bank_policies

# AWS (solo Fase 2 — dejar vacío en local)
AWS_REGION=
AWS_PROFILE=
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
